{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quidkey-website",
  // Account ID is not sensitive (it's in every dashboard URL); hardcoding it here
  // means CI only needs the CLOUDFLARE_API_TOKEN secret.
  "account_id": "c9f9214a657cd857ffff4b9b2e9292e2",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-06-05",
  // nodejs_compat is required: TanStack Start's server runtime uses
  // node:async_hooks (AsyncLocalStorage) for its per-request context.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // HubSpot Forms API targets. None of these values is a secret (they are all
  // public in any HubSpot embed snippet), so they live here rather than in
  // `wrangler secret`.
  // HUBSPOT_FORM_GUID: "Website: Surcharge calculator lead gate" form —
  //   fields email, monthly_card_turnover, average_card_fee_rate,
  //   marketing_consent. If it is ever emptied the gate fails closed.
  // HUBSPOT_CONTACT_FORM_GUID: "Website: Talk to us" form, used by the
  //   contact dialog and /contact — fields firstname, email, company, message
  //   and the hidden custom property contact_topic. If it is ever emptied the
  //   form shows the support email as the fallback.
  // HubSpot rejects submissions carrying fields that are not on the form, so
  // keep these field lists in step with src/lib/submit-lead.ts and
  // src/lib/submit-contact.ts.
  // The portal is EU-hosted, so submissions go to api-eu1.hsforms.com; the code
  // defaults to that host and HUBSPOT_FORMS_HOST only exists to override it.
  // MAILCHIMP_AUDIENCE_ID: the audience (list) the footer newsletter form
  //   subscribes to; see src/lib/subscribe-newsletter.ts. Not a secret (it is
  //   in every Mailchimp embed form). The API key IS a secret and lives in
  //   `wrangler secret put MAILCHIMP_API_KEY`. If either is missing the form
  //   fails closed and asks the visitor to try again later.
  "vars": {
    "HUBSPOT_PORTAL_ID": "145375174",
    "HUBSPOT_FORM_GUID": "e8103289-bf6f-4fdc-8e0b-3067f33bb298",
    "HUBSPOT_CONTACT_FORM_GUID": "a708aac4-87da-4568-9c4b-d528efed202e",
    "MAILCHIMP_AUDIENCE_ID": "65ab5af61e"
  },
  // Static assets (the client build) are wired automatically to dist/client by
  // @cloudflare/vite-plugin — no explicit "assets" block needed.

  // Production custom domains, bound to this worker (the apex + www records are
  // Cloudflare-managed). Deploying is idempotent once these exist.
  "routes": [
    { "pattern": "quidkey.com", "custom_domain": true },
    { "pattern": "www.quidkey.com", "custom_domain": true }
  ]
}
